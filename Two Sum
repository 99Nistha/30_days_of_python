class Solution:
    def twoSum(self, nums: list[int], target: int) -> list[int]:
        seen={}
        for i in range(len(nums)):
            num= nums[i]
            t= target-num
            if t in seen:
                return [seen[t],i]
            seen[num]=i
        return []



